# ─── Database ────────────────────────────────────────────────────────────────
DB_NAME=rent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db          # docker-compose service name; use "localhost" if running backend locally
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis    # docker-compose service name; use "localhost" if running backend locally
REDIS_PORT=6379

# ─── Bot ─────────────────────────────────────────────────────────────────────
BOT_TOKEN=          # BotFather token
BACKEND_HOST=http://backend:8000   # use http://localhost:8000 if running backend locally

# ─── Frontend ────────────────────────────────────────────────────────────────
# Локально: http://localhost:8000
# Telegram Mini App через тоннель: https://xxxx.trycloudflare.com (тоннель на порт 8000)
VITE_API_BASE_URL=http://localhost:8000

# ─── CORS (for local dev with tunnel) ────────────────────────────────────────
SERVER_CORS_INCLUDE_LOCAL_DEV=true
# SERVER_CORS_ORIGINS=https://xxxx.trycloudflare.com  # раскомментировать при использовании тоннеля

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production   # openssl rand -hex 32

# ─── Order payment ───────────────────────────────────────────────────────────
ADMIN_CHAT_ID=         # Group/supergroup chat ID (negative number) for receipts & reminders
PAYMENT_CARD_NUMBER=   # Card number shown to client for deposit transfer
DEPOSIT_PERCENT=20     # Deposit amount as % of order total_price

# ─── Rental billing (defaults in backend/src/settings/billing.py) ───────────
# Half-day-step billing: evening pickup grace + return leniency.
# MUST stay in sync with frontend/src/utils/rental.ts (BILLING const).
# BILLING_TIMEZONE=Asia/Tashkent
# BILLING_EVENING_PICKUP_HOUR=17       # pickup at/after this local hour → billing starts next day
# BILLING_DAY_START_HOUR=9             # ...at this hour
# BILLING_RETURN_LENIENCY_MINUTES=120  # subtracted from duration before rounding
# BILLING_ROUNDING_STEP_MINUTES=720    # 12h = 0.5-day step, rounded up
# BILLING_MIN_HALF_DAYS=2              # minimum charge = 1 day
# BILLING_TOTAL_FLOOR_STEP=100         # floor order total to nearest 100 sum

# ─── Admin panel & calendar login ────────────────────────────────────────────
# The SQLAdmin panel (/admin) and the rental calendar (/app/admin) are gated by a
# username/password login sharing one session cookie — log in once, get both.
ADMIN_SESSION_SECRET=      # Long random string signing the admin session cookie. REQUIRED in prod.
ADMIN_SESSION_HTTPS_ONLY=true  # Mark the session cookie Secure (HTTPS only). Keep false for local http dev.
ADMIN_BOOTSTRAP_USERNAME=  # First admin login, created only if the admin_users table is empty
ADMIN_BOOTSTRAP_PASSWORD=  # First admin password (change/add more admins later inside the panel)
ADMIN_TELEGRAM_IDS=    # Legacy; no longer used for calendar access (kept to avoid breaking existing envs)
INTERNAL_API_TOKEN=    # Shared secret for backend<->bot server-to-server calls. REQUIRED (long random string).
FRONTEND_URL=          # Public HTTPS origin of the Mini App, e.g. https://camping-rent.uz — used by the bot's
                       # /admin_calendar command to open the calendar as a Telegram WebApp button

# ─── Dev overrides ───────────────────────────────────────────────────────────
SERVER_RELOAD=false   # set true to enable hot reload (requires volume mount in docker-compose)

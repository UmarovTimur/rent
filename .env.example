# ─── Database ────────────────────────────────────────────────────────────────
DB_NAME=rent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db          # docker-compose service name; use "localhost" if running backend locally
DB_PORT=5432

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis    # docker-compose service name; use "localhost" if running backend locally
REDIS_PORT=6379

# ─── Bot ─────────────────────────────────────────────────────────────────────
BOT_TOKEN=          # BotFather token
BACKEND_HOST=http://backend:8000   # use http://localhost:8000 if running backend locally

# ─── Frontend ────────────────────────────────────────────────────────────────
# Локально: http://localhost:8000
# Telegram Mini App через тоннель: https://xxxx.trycloudflare.com (тоннель на порт 8000)
VITE_API_BASE_URL=http://localhost:8000

# ─── CORS (for local dev with tunnel) ────────────────────────────────────────
SERVER_CORS_INCLUDE_LOCAL_DEV=true
# SERVER_CORS_ORIGINS=https://xxxx.trycloudflare.com  # раскомментировать при использовании тоннеля

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production   # openssl rand -hex 32

# ─── Dev overrides ───────────────────────────────────────────────────────────
SERVER_RELOAD=false   # set true to enable hot reload (requires volume mount in docker-compose)
